[user]
  name = Rob Johnson
  email = rob@rob-johnson.me
[color]
  ui = auto
[core]
	excludesfile = ~/.gitignore_global
  whitespace = tab-in-indent,tabwidth=4
  preloadindex = true
  pager = less
  fsync = objects
[diff]
  mnemonicprefix = true
  renames = copy
[pack]
  threads = 0
[rerere]
  enabled = 1
[branch "master"]
  remote = origin
  merge = refs/heads/master
[url "git@github.com:"]
  insteadOf = "gh:"
  pushInsteadOf = "github:"
  pushInsteadOf = "git://github.com/"
  pushInsteadOf = "https://github.com/"
[url "gitolite@git.semantico.net:"]
  insteadOf = "s:"
[merge]
  log = true
  tool = vimdiff
[alias]
  lol = log --graph --decorate --oneline
  lola = log --graph --decorate --oneline --all
  h = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
[push]
	default = upstream
[credential]
	helper = !sh -c 'command -v git-credential-osxkeychain >/dev/null 2>&1 && exec git-credential-osxkeychain "$1" || command -v git-credential-libsecret >/dev/null 2>&1 && exec git-credential-libsecret "$1" || exec git credential-cache --timeout=3600 "$1"' -
