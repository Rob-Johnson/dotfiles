# Ghostty Configuration - Optimized for tmux + SSH workflow
# Only settings that improve over defaults for your specific use case

# Normal drags go to tmux; Shift-drag always performs a native Ghostty selection.
mouse-shift-capture = never

# Improve copy/paste across macOS and SSH to Ubuntu
# Default on macOS: true (selection only) - this ensures system clipboard too
copy-on-select = clipboard

# Better terminal identification for complex applications
# Default: varies - this ensures consistent terminal capabilities
term = xterm-ghostty

# Permit tmux to update the macOS clipboard through OSC 52.
clipboard-write = allow

# Safety when pasting commands across different systems
# Protects against accidentally pasting dangerous commands
clipboard-paste-protection = true